# syntax=docker/dockerfile:1

ARG UV_VERSION=0.9.9
ARG PYTHON_VERSION=3.14

# === UV Stage ===
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# === Builder Stage ===
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local

COPY packages ./packages

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml,ro \
    --mount=type=bind,source=uv.lock,target=uv.lock,ro \
    uv sync --frozen --compile-bytecode && \
    uv pip list

# === Runtime Stage ===
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/SimWorks"

WORKDIR /app

COPY --from=builder /usr/local /usr/local

ARG UID=10001
RUN adduser --disabled-password --gecos "" --home "/nonexistent" \
    --shell "/sbin/nologin" --no-create-home --uid "${UID}" appuser && \
    mkdir -p /app/static /app/media /app/logs /app/docker && \
    chown -R appuser:appuser /app

RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

USER appuser

COPY tailwind.config.js /app/

COPY SimWorks /app/SimWorks

# Pre-fetch the standalone Tailwind CLI at build time so `tailwind watch`
# does not need network access on first container start. Must match
# TAILWIND_CLI_VERSION in config/settings.py.
#
# Stored outside /app/SimWorks on purpose: compose.dev.yaml bind-mounts the
# host's SimWorks/ over that path, which would hide anything baked in here.
# The tailwind-watch service points TAILWIND_CLI_PATH at this directory.
ARG TAILWIND_CLI_VERSION=4.1.18
RUN mkdir -p /app/.tailwind-cli && \
    curl -fsSL -o /app/.tailwind-cli/tailwindcss-linux-x64-${TAILWIND_CLI_VERSION} \
        "https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWIND_CLI_VERSION}/tailwindcss-linux-x64" && \
    chmod +x /app/.tailwind-cli/tailwindcss-linux-x64-${TAILWIND_CLI_VERSION}

COPY --chown=appuser:appuser --chmod=0755 docker/entrypoint.sh /app/docker/entrypoint.sh
COPY --chown=appuser:appuser --chmod=0755 docker/healthcheck.sh /app/docker/healthcheck.sh

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=12 CMD /app/docker/healthcheck.sh

WORKDIR /app/SimWorks
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["uvicorn", "config.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/SimWorks", "--reload-dir", "/app/packages"]
